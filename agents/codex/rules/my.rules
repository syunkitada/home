# read tools
prefix_rule(pattern=["printf"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["nl"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["ss"], decision="allow")
prefix_rule(pattern=["netstat"], decision="allow")
prefix_rule(pattern=["test"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")

# write tools
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["rm"], decision="allow")
prefix_rule(pattern=["mktemp"], decision="allow")
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["set"], decision="allow")

# dev tools
prefix_rule(pattern=["git"], decision="allow")
prefix_rule(pattern=["make"], decision="allow")

# programming language tools
prefix_rule(pattern=["sh"], decision="allow")
prefix_rule(pattern=["command"], decision="allow")
prefix_rule(pattern=["bash"], decision="allow")
prefix_rule(pattern=["zsh"], decision="allow")
prefix_rule(pattern=["perl"], decision="allow")
prefix_rule(pattern=["python"], decision="allow")
prefix_rule(pattern=["go"], decision="allow")
prefix_rule(pattern=["gofmt"], decision="allow")
prefix_rule(pattern=["golangci-lint"], decision="allow")
prefix_rule(pattern=["npm"], decision="allow")
prefix_rule(pattern=["npx"], decision="allow")
prefix_rule(pattern=["vite"], decision="allow")
